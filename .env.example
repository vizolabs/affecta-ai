# Backend environment variables (FastAPI). Copy to `.env` and edit as needed.
# All values below are the built-in defaults — the app runs with no .env at all.
# The API loads `.env` from the project root automatically (python-dotenv).

# SQLite by default; set to e.g. postgresql://user:pass@host/db to switch.
# Default file is data/app.db (an existing legacy data/affecta.db is adopted).
AFFECTA_DB_URL=

# Bearer-token lifetime in seconds (default 7 days).
AFFECTA_TOKEN_TTL=604800

# Default analysis model — one of: dan | ddamfn | vit_small | efficientnet_b3
AFFECTA_MODEL=dan

# Load the model at startup (1) or lazily on first request (0).
AFFECTA_WARM_MODEL=1

# Debounce before an expression transition is emitted, in seconds.
AFFECTA_TRANSITION_DEBOUNCE_SECONDS=1.0

# CORS (comma-separated origins). Unset = allow the Next.js dev server
# (localhost:3000 + 127.0.0.1:3000). Set to empty to disable CORS entirely.
AFFECTA_CORS_ORIGINS=

# Logging level: DEBUG | INFO | WARNING | ERROR
AFFECTA_LOG_LEVEL=INFO
